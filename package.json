{
  "name": "amplite",
  "productName": "Amplite",
  "version": "1.6.1",
  "description": "A lightweight Spotify desktop player with themes and a mini amp.",
  "main": "main.js",
  "author": "larosa023",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:zip": "electron-builder --win zip"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v43.8.3+wvcus",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.larosa023.amplite",
    "productName": "Amplite",
    "electronVersion": "43.8.3+wvcus",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "files": [
      "main.js",
      "preload.js",
      "engine.js",
      "src/**/*",
      "build/icon.png",
      "!**/*.map",
      "!**/*.md",
      "!**/LICENSE*",
      "!**/test/**",
      "!**/*.d.ts"
    ],
    "afterPack": "build/vmp-sign.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Amplite-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Amplite",
      "artifactName": "Amplite-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Amplite-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "larosa023",
        "repo": "Amplite",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "librespot*"
        ]
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
